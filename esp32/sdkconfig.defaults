# the session, tls and the demo's drawing run on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
# a sleep shorter than a tick spins instead of yielding, and usb.rs polls
# each millisecond
CONFIG_FREERTOS_HZ=1000

# the log goes to the uart alone. with a second console on the usb serial
# port, what rust prints lands on a descriptor that is not the console
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# pictures and the encoder's buffers live in the psram. esp-idf counts its
# full speed as experimental, and runs it at a tenth of that otherwise
CONFIG_SPIRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
# a larger cache in front of it, in longer lines: filling an rgb picture
# took 9 ms in place of 16. the largest, 512 KB, leaves the encoder no room
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# music files have long names, and not all of them in ascii: without these
# the card's filesystem gives each as eight letters and three
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# the phone side of android auto is a usb device with one vendor interface,
# on the high speed port
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_RHPORT_HS=y
# the controller's interrupts move the data, not its dma: with dma, video
# going out 4 KB at a time while touches come in, records arrive corrupt
# in both directions about every other minute. seen on the full speed port
CONFIG_TINYUSB_MODE_SLAVE=y
# tinyusb's task on the core its interrupt is on, which is the main task's,
# where the driver is installed. the usb driver keeps the interrupt out of
# a transfer it is starting by stopping interrupts on the core it runs on:
# started on the other core, the two write the same endpoint at once, and
# a transfer is lost for good. usb.rs pins the threads of ours that start
# transfers to the same core
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
