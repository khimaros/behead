# raspi-provision project config for the rpi4 image. `make rpi-image` copies
# this to customize.env (gitignored) on first use; edit that copy.

CUSTOM_HOSTNAME=behead
#CUSTOM_USERNAME=myuser
# password must be at least 8 bytes for the hotspot to work
#CUSTOM_PASSWORD=mypassword

# read-only root with a ram upper layer, so losing power in the van cannot
# corrupt the card
OVERLAY=tmpfs

# reuse the upstream image raspi-provision already downloaded
IMAGE_RASPIOS=../../raspi-provision/images/raspios-lite.img.xz

# the usb port is taken by android auto while the service runs, so reach the
# device over ethernet (10.55.1.1) or the hotspot (10.55.2.1)
ADDRESS=10.55.1.1

# the sdcard device that `raspi-provision flash` writes -- destructive, mind it.
#MOUNT_DEVICE=/dev/sdX
