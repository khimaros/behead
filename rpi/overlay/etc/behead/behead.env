# shell command that writes annex-b h.264 to stdout. {width}, {height} and
# {fps} are replaced with the mode the car negotiated, and touch and button
# events from the car arrive on its stdin. the default is the demo program,
# which draws the negotiated mode, every finger and the last button pressed.
# shell command that writes what the car should play, as pcm, to stdout.
# empty for none, as the demo has no sound
AUDIO_CMD=
# milliseconds to hold that sound back for the picture. empty for none
AUDIO_DELAY=
# what a turn of the car's rotary knob types into a session: focus (tab and
# shift+tab) or arrows (down and up). empty for focus
KNOB=
VIDEO_CMD="behead-demo --width {width} --height {height} --fps {fps} | ffmpeg -loglevel error -f rawvideo -pix_fmt rgb24 -s {width}x{height} -r {fps} -i - -pix_fmt yuv420p -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline -g {fps} -f h264 -"
