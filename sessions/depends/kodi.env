# records what kodi plays, for the car's speakers
AUDIO_CMD="/usr/local/lib/behead/sessions/audio.sh {rate} {channels}"
# milliseconds the sound waits for the picture, which capture, encoding and
# the car's decoder hold up. a first guess by ear in the van: raise it if
# lips move after the words, lower it if before
AUDIO_DELAY=150
# a turn of the car's knob goes down and up kodi's lists. tab, what it is
# elsewhere, leaves the menus for whatever is playing
KNOB=arrows
# kodi draws with opengl, which the pi's cpu is slow at. untried on a pi
BEHEAD_RENDERER=gles2
