# records what the session's pulseaudio plays, for the car's speakers
AUDIO_CMD="/usr/local/lib/behead/sessions/audio.sh {rate} {channels}"
# milliseconds the sound waits for the picture, as for kodi. untuned for phosh
AUDIO_DELAY=150
# the pi's cpu is slow at drawing the shell and its applications, as it was
# for android
BEHEAD_RENDERER=gles2
# the style applications are asked for: dark, light, or car, which is dark
# until the car says it is day and then follows it
BEHEAD_COLOR_SCHEME=dark
# a car with a knob and no touchscreen: a long click steps the knob from
# moving between things, to moving within a list, to a map's zoom, to
# writing, and back closes what is open
KNOB=focus,arrows,scroll,type
BACK=escape
