# records what the session's pulseaudio plays, for the car's speakers
AUDIO_CMD="/usr/local/lib/behead/sessions/audio.sh {rate} {channels}"
# milliseconds the sound waits for the picture, as for kodi. untuned for phosh
AUDIO_DELAY=150
# the pi's cpu is slow at drawing the shell and its applications, as it was
# for android
BEHEAD_RENDERER=gles2
